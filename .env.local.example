# App URL (used for generating PWA links in WhatsApp messages)
NEXT_PUBLIC_APP_URL=https://srv1339976.hstgr.cloud

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# REQUIRED: Service role key for admin operations (AI, user management, etc.)
# Find it in Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 302.AI Configuration (OpenAI-compatible API gateway)
# Get your API key from https://302.ai/ → Console → API Keys
# Supports: GPT-4o, Claude, Gemini, DALL-E, Whisper, etc.
# Docs: https://doc-en.302.ai/
OPENAI_API_KEY=your_302ai_api_key
OPENAI_BASE_URL=https://api.302.ai/v1

# WhatsApp Service (Self-hosted on VPS)
# Change to your VPS IP when deployed, e.g., http://123.45.67.89:3001
WHATSAPP_SERVICE_URL=http://localhost:3001
WHATSAPP_SERVICE_KEY=your-secret-api-key-here

# WATI WhatsApp API (Optional - not used if using self-hosted service)
WATI_API_KEY=your_wati_api_key
WATI_API_URL=https://live-server-xxxx.wati.io

# POS Integration - Feed Me
POS_API_KEY=your_feedme_api_key
POS_SYSTEM=feedme

# ReadyShare.AI Integration
READYSHARE_API_URL=https://api.readyshare.ai
READYSHARE_API_KEY=your_readyshare_api_key
